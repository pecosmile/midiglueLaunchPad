<Comment>
prgChangeBox

kokou ni-sui@sabaco

<I/O>
input Int : LaunchPad制御（0=Disable）
input MidiPacket : proglam change入力
input MidiPacket : launchpadからの入力
input Int : プログラムチェンジタイミング(10を受けるとプログラムチェンジ)
output MidiPacket : proglam change出力
output IntList : 描画情報。lpControlへの接続します。
output String : ステータス情報を出力します。
output Int : link muteDigitakt(extendMuteイネーブル)

<Description>
LaunchPad上に、プログラムチェンジ用の画面を表示、押した場所に対応するプログラムを送ります。
また、入力したprogram changeに対応するボタンを光らせます。

※ノード単体では動きません。main_template.cppに、専用の定数・クラスを設定する必要があります。


<Parameter>
parameter Locate = 0 : 描画位置(0-6)
parameter Height = 4 : 描画範囲(2-8)
parameter Channel = 16 : チャンネル(1-16)
parameter LinkBarGage = false : BarGageBoxとのリンク

<Setup>
// Bung設定
${this}( &(Midiglue::__bang) , Midiglue::SETUP );

<Code>

/*********************************************
 * 定数
**********************************************/
static const uint8_t LOCATE_Y = ${Locate};  // 基準位置（縦）
static const uint8_t BOXSIZE_X = 8;         // サイズ（横）
static const uint8_t BOXSIZE_Y = ${Height}; // サイズ（縦）
static const uint8_t MIDI_CH = ${Channel};  // チャンネル
static const uint8_t SCROOL_MAX = 16;  // スクロールの最大値(8*16)

// 右側[>]の位置
static const uint8_t SCRKEY_UP = 0;         // スクロールキー：上
static const uint8_t SCRKEY_DOWN = 1;       // スクロールキー：下


// プログラムのステータス
static const uint8_t PRGST_BLANK = 0;       // 空
static const uint8_t PRGST_SET = 10;        // データあり
static const uint8_t PRGST_FILL1 = 20;      // FILL1
static const uint8_t PRGST_FILL2 = 21;      // FILL2

// システムパケット
static const auto CLOCK = MidiPacket::makeTimingClock();
static const auto STOP = MidiPacket::makeTimingClockStop();
static const auto START = MidiPacket::makeTimingClockStart();
static const auto CONTINUE = MidiPacket::makeTimingClockContinue();


// プログラム識別用の色(データ無し)
static const uint8_t mColor_base[8] = {
    LP3C_D_RED,
    LP3C_D_GBLUE,
    LP3C_D_YELLOW,
    LP3C_D_PINK,
    LP3C_D_LGREEN,
    LP3C_D_BLUE,
    LP3C_D_PURPLE,
    LP3C_D_LBLUE
};
// プログラム識別用の色(データあり)
static const uint8_t mColor_light[8] = {
    LP3C_RED,
    LP3C_GBLUE,
    LP3C_YELLOW,
    LP3C_PINK,
    LP3C_LGREEN,
    LP3C_BLUE,
    LP3C_PURPLE,
    LP3C_LBLUE
};
// プログラム識別用の色(fillIn:1Bar)
static const uint8_t mColor_fill1[8] = {
    LP3C_ORANGE,
    LP3C_ORANGE,
    LP3C_ORANGE,
    LP3C_ORANGE,
    LP3C_ORANGE,
    LP3C_ORANGE,
    LP3C_ORANGE,
    LP3C_ORANGE
};
// プログラム識別用の色(fillIn：2Bar)
static const uint8_t mColor_fill2[8] = {
    LP3C_L_RED,
    LP3C_L_GBLUE,
    LP3C_L_YELLOW,
    LP3C_L_PINK,
    LP3C_L_LGREEN,
    LP3C_L_BLUE,
    LP3C_L_PURPLE,
    LP3C_L_LBLUE
};


// 色：現在プログラム
static const uint8_t CL_NOW = LP3C_WHITE;
// 色：選択中プログラム
static const uint8_t CL_SETTING = LP3C_BPURPLE;
// 色：カーソル(通常、色読込、色編集)
static const uint8_t CL_CURSOR_IDOL         = LP3C_L_YELLOW;
static const uint8_t CL_CURSOR_LOAD_WAIT    = LP3C_L_BLUE;
static const uint8_t CL_CURSOR_LOAD_INPUT   = LP3C_D_RED;
static const uint8_t CL_CURSOR_CLR_EDIT     = LP3C_L_LGREEN;

// ステータス
static const uint8_t ST_IDOL       = 0;     // IDOL
static const uint8_t ST_PLAY       = 1;     // 再生中
static const uint8_t ST_LORD_WAIT  = 10;    // セッティング(wait)
static const uint8_t ST_LORD_INPUT = 11;    // セッティング(入力中)

// 1ステップ/クロック
static const uint8_t CLOCK4STEP = 6;


/*********************************************
 * 変数
**********************************************/
// Launchpad 描画情報
static IntList mpDispLp3 = Midiglue::init_default<IntList>();
// ステータス
static uint8_t mStatus = ST_IDOL;
// ステータス表示文字列
static String mStrStatus = Midiglue::make_string("IDLE");

// スクロール位置
static uint8_t mScrool = 0;
// [>]の最後に押された位置
static uint8_t mScrKey = 0;

// 現在のプログラムNo
static uint8_t mNowPrgNo = 0xff;
// 指定したプログラムNo
static uint8_t mSettingPrgNo = 0xff;

// カウント
static uint8_t mClockCount = 0;
static uint8_t mBarCount = 0;
static uint8_t mBarLength = 8;

// LaunchPad入出力許可フラグ
static bool lpEnable = true;

// プログラム情報(縦16*横8)→y,x
static uint8_t mPrgStateMap[SCROOL_MAX][BOXSIZE_X];

/*********************************************
 * 関数
**********************************************/

// プログラム番号から表示位置に変換
// prgNo < 0x80 でお願いします
// prgNo:プログラム番号
// x:x位置(ポインタ)
// y:y位置(ポインタ)
static auto progNo2Locate = [&](uint8_t prgNo,uint8_t* x,uint8_t* y){
    *x = prgNo%8;
    *y = prgNo/8;
};

// yy位置が表示範囲内かどうかの判定
// y:y位置
static auto checkOfRangeIn = [&](uint8_t y) -> bool {
    if(y < mScrool || y >= mScrool + BOXSIZE_Y) {
        return(false);
    }
    return(true);
};

// メモリ初期化
static auto crearPrgStateMap = [&](){
    static uint8_t x;
    static uint8_t y;
    // メモリ内容を全て初期化する。
    for(y=0;y<SCROOL_MAX;y++){
        for(x=0;x<BOXSIZE_X;x++){
            mPrgStateMap[y][x] = PRGST_BLANK;
        }
    }
};

// 指定した位置の色を返す
static auto getBaseColor = [&](uint8_t x,uint8_t y)-> uint8_t {

    // 設定したい色
    uint8_t color = LP3C_BLACK;
    // ステータスによって色を設定
    // 2段ごと（16ごと）に色を変える
    switch(mPrgStateMap[y][x]){
        case PRGST_SET:
            color = mColor_light[y/2];
        break;
        case PRGST_FILL1:
            color = mColor_fill1[y/2];
        break;
        case PRGST_FILL2:
            color = mColor_fill2[y/2];
        break;
        default:
            color = mColor_base[y/2];
        break;
    }

    return(color);
};


// 特殊色状態の設定
// 演奏中のプログラム番号の場合はCL_NOW、送信済みのプログラム番号の場合はCL_SETTINGを設定
// prgNo：判定したいプログラム番号
// *color：色(戻り値)
// *mode：明滅パターン(戻り値)
static auto changeColorAndMode = [&](uint8_t prgNo,uint8_t* color,uint8_t* mode) {
    // 色と明滅パターンを変える
    if(prgNo == mNowPrgNo) {
        *color = CL_NOW;
        *mode = LP3B_PULS;
    } else if(prgNo == mSettingPrgNo) {
        *color = CL_SETTING;
        *mode = LP3B_PULS;
    }
};


// program Noから描画処理
static auto drowProglamNo = [&](uint8_t prgNo) {
    // 描画不要
    if(!lpEnable) { return; }

    // プログラム番号を座標に変換
    uint8_t x = 0;
    uint8_t y = 0;
    progNo2Locate(prgNo,&x,&y);

    // 表示範囲外なら処理不要
    if(!checkOfRangeIn(y)) {
        return;
    }

    // 色と明滅モードの設定
    uint8_t color = getBaseColor(x,y);
    uint8_t mode = LP3B_NOMAL;
    changeColorAndMode(prgNo,&color,&mode);

    // 座標補正
    y -= mScrool;

    // LP3への送信
    Lp3::addDot(mpDispLp3,mode,x,LOCATE_Y + y,color);
};

/*****************
 * カーソルボタン描画
 * モードによって色を変える
 */
static auto drowCursorButton = [&](){


    // 色の決定
    uint8_t color = CL_CURSOR_IDOL;
    switch(mStatus){
        case ST_IDOL:
        case ST_PLAY:
            color = CL_CURSOR_IDOL;
        break;
        case ST_LORD_WAIT:
            color = CL_CURSOR_LOAD_WAIT;
        break;
        case ST_LORD_INPUT:
            color = CL_CURSOR_LOAD_INPUT;
        break;
    };

    // カーソル
    Lp3::addDot(mpDispLp3,LP3B_NOMAL,8,LOCATE_Y + SCRKEY_UP  ,color);
    Lp3::addDot(mpDispLp3,LP3B_NOMAL,8,LOCATE_Y + SCRKEY_DOWN,color);

    // 外側を黒で塗る
    for(int y = SCRKEY_DOWN+1 ;y<BOXSIZE_Y;y++){
        Lp3::addDot(mpDispLp3,LP3B_NOMAL,8,LOCATE_Y + y,LP3C_BLACK);
    }

};



/***********************************************************************
* 再描画
 ***********************************************************************/
static auto reDrow = [&](){
    // 描画位置に対応するprogram No
    // note:座標位置確定毎にgetProgramNoを呼んでもいいけど、1ずつしか
    // 増えない事が確定しているので。
    uint8_t prgNo = mScrool * 8;

    for(int y=0;y<BOXSIZE_Y;y++){

        // box上のy位置（描画範囲ではない）を確定
        uint8_t boxY = y + mScrool;
        for(int x=0;x<BOXSIZE_X;x++){
            // 指定した段の色を取得
            uint8_t baseColor = getBaseColor(x,y + mScrool);
            // 色と明滅パターンの設定
            uint8_t color = baseColor;
            uint8_t mode = LP3B_NOMAL;
            changeColorAndMode(prgNo,&color,&mode);
            // LP3への送信
            Lp3::addDot(mpDispLp3,mode,x,LOCATE_Y + y,color);
            // プログラム番号を次に送る
            ++prgNo;
        }
    }
    // カーソルボタン描画
    drowCursorButton();
    
};

/***********************************************************************
 * 共通処理
 ***********************************************************************/

/*****************
 * Launch pad への送信
 */
static auto outLaunchPad = [&](){
    if(lpEnable)
    {
        // 出力
        out1 = mpDispLp3;
    }
};

/*****************
 * バンク内下段のプログラム確認
 * @param prgNo  プログラムNo
 * プログラムの下段をFillパターンとして判定
 */
static auto isFillPattern = [&](uint8_t prgNo) -> bool {
    return((prgNo % 16) >= 8 );
};

/***********************************************************************
* programChange系関数
 ***********************************************************************/
/*****************
 * programChange送信
 * @param value value値
 */
static auto sendProgramchange = [&](uint8_t prgNo){
    auto packet = MidiPacket::makeProgramChange(MIDI_CH, prgNo);
    out0 = packet;
};

/*****************
 * programChangeのDelay送信
 */
static auto prgChangeDelay = [&](){
    sendProgramchange(mSettingPrgNo);
};


/***********************************************************************
* 初期化処理
 ***********************************************************************/
static auto initDrow = [&](){
    // Launchpadバッファのクリア
    mpDispLp3->clear();
    // LaunchPadへの送信バッファ設定
    reDrow();
    // 自動送信されないのでLaunchPadへの送信を行う
    outLaunchPad();
};



/*********************************************
* 割り込みイベント
**********************************************/
// LaunchPadの初期表示
static auto initEvent = Midiglue::make_oneshot_us_event<>(initDrow);

// programChangeをDelayさせるためのタイマ
static auto prgChangeEvent = Midiglue::make_oneshot_us_event<>(prgChangeDelay);



// 入力：プログラムチェンジ
static auto inputPrgChange = [&](uint8_t prgNo){

    // mSettingPrgNoの位置が上書き対象でない（入力されたプログラムチェンジと違う）
    // 場合、mSettingPrgNoの描画を先に削除する。
    uint8_t tmpPrgNo = mSettingPrgNo;
    mSettingPrgNo = 0xff;    
    if(tmpPrgNo != prgNo){
        drowProglamNo(tmpPrgNo);
    }

    // program No の変更
    tmpPrgNo = mNowPrgNo;
    mNowPrgNo = prgNo;

    // Launch Pad描画
    drowProglamNo(tmpPrgNo);
    drowProglamNo(mNowPrgNo);

    // 再生中に、下段のパターンに遷移した場合、自動で次のパターン（右上）を選択する
    // ただし、一番右のパターンでは無効（移動先が無いため）
    if(
        mStatus == ST_PLAY               // 再生中
        && isFillPattern(mNowPrgNo)     // 下段パターン
        && not(mNowPrgNo % 8 == 7)      // 一番右のパターン以外
    ) {
        // 右上のパターンに遷移する
        mSettingPrgNo = mNowPrgNo - 7;
        drowProglamNo(mSettingPrgNo);
        // 0.2秒後にプログラムチェンジを呼び出す
        prgChangeEvent->schedule(200 * 1000);
    }

};

/*****************
 * ステータス設定
 * @param status 変更するステータス
 */
static auto setStatus = [&](uint8_t status){

    // ステータス変更
    mStatus = status;

    // カーソルボタン描画
    drowCursorButton();

    // ステータス出力
    static String msg;
    if(status < ST_LORD_WAIT){
        msg = Midiglue::make_string("IDLE");    
    } else if(status == ST_LORD_WAIT){
        msg = Midiglue::make_string("wait data");
    } else if(status == ST_LORD_INPUT){
        msg = Midiglue::make_string("input now...");
    }
    out2 = msg;
};

/***********************************************************************
* カーソルボタン描画を3秒押しっぱなし
 ***********************************************************************/
static auto changeMode2Wait = [&](){

    if(mScrKey == SCRKEY_DOWN){
        // 下を押した場合（色読み込みモード）
        // メモリ内容を全て初期化する。
        crearPrgStateMap();
        // セッティング(wait)
        setStatus(ST_LORD_WAIT);
        // タイマ割り込み中は、自動送信されないのでLaunchPadへの送信を行う
        outLaunchPad();
    }
};
/*********************************************
* 割り込みイベント
**********************************************/
// LaunchPadの初期表示
static auto timerModeChange = Midiglue::make_oneshot_us_event<>(changeMode2Wait);


// 入力：カーソルキーを押している場合
static auto inputScrool = [&](int vactor) -> bool {
    // スクロール
    uint8_t moveTo = mScrool + vactor;
    // スクロールの最大値を越える場合は処理出来ない
    // ※結果が0未満の場合もオーバーフローによって最大値を超える
    if(moveTo > (SCROOL_MAX - BOXSIZE_Y) ) {
        return(true);
    }
    // スクロール位置を移動して再描画
    mScrool = moveTo;
    reDrow();
    return(true);
};


/*****************
 * link muteDigitakt送信
 */
static auto updateExMuteEnable = [&](uint8_t oldPrgNo,uint8_t newPrgNo){

    if(oldPrgNo == newPrgNo)
    {   return; }

    // 下段パターンから、上段のパターンに移動するときはミュート処理をしない。
    out3 = (isFillPattern(oldPrgNo) && (newPrgNo == oldPrgNo-8)) ? 0:1;
};


/*****************
 * LaunchPadからの入力
 * @param x 押されたボタンのX軸(0～8)
 * @param y 押されたボタンのy軸(0～8)
 * @param value value値
 */
static auto inputProgramChange = [&](uint8_t x,uint8_t y,uint8_t value){
    // 入力不要
    if(!lpEnable) { return; }

    // Midiglue::Debug::write_log("inputProgramChange", x*10+y);

    // boxの範囲内であることを確認(縦)
    if(y < LOCATE_Y || y >= (LOCATE_Y + BOXSIZE_Y)){
        return;
    }

    // boxの範囲内であることを確認(横)
    if(x<LP3_maxXY){
        // y軸補正
        y += (mScrool - LOCATE_Y);
        // progNo
        uint8_t prgNo = x + y*LP3_maxXY;
        // program No の変更
        uint8_t oldPrgNo = mSettingPrgNo;
        mSettingPrgNo = prgNo;
        // Launch Pad描画
        drowProglamNo(oldPrgNo);
        drowProglamNo(mSettingPrgNo);
        // midi outへの出力
        if(!${LinkBarGage}){
            updateExMuteEnable(mNowPrgNo,mSettingPrgNo);
            sendProgramchange(mSettingPrgNo);
        }
    }
    else { // ボックスの右側[>] が押されている。
        // y軸補正
        y -= LOCATE_Y;
        // モード切替
        if(value == 0) {
            // ボタンを離した時はタイマをキャンセルする。
            // 右側全てでキャンセルになるけど、仕様とする
            timerModeChange->cancel();
        }
        else
        {
            // スクロール
            if(y == SCRKEY_UP  ) { inputScrool(-1); }   // 上スクロール
            if(y == SCRKEY_DOWN) { inputScrool(+1); }   // 下スクロール
            // ボタンを3秒以上押しっぱなしを判定するためのタイマーをセット
            if(mStatus < ST_LORD_WAIT){
                timerModeChange->schedule(3000 * 1000);
                mScrKey = y;
            }

        }
    }

};

// 入力：LaunchPad
static auto inputLaunchPad = [&](MidiPacket packet){
    // LaunchPad制御制限されている場合、onイベントは無視する。
    // ※押しながら切り替えられる可能性があるため、offイベントは受ける
    if(!lpEnable && 0 < packet.getControlValue())
    {   return; }

    // 押された場所の取得
    static uint8_t x;
    static uint8_t y;
    if(!Lp3::getLocation(packet,&x,&y)){
        // 処理が必要なボタンが押された場合
        inputProgramChange(x,y,packet.getControlValue());
    }


};

// 入力：通常ステータス
static auto inputMidiNomal = [&](MidiPacket packet){
    // プログラムチェンジ処理
    if (Midiglue::is_valid(packet) && MIDI_CH == packet.getChannel() && packet.isProgramChange()){
        inputPrgChange(packet.getProgramNumber());
    }
    else if(packet == START || packet == CONTINUE) {
        setStatus(ST_PLAY);
    }
    else if(packet == STOP){
        setStatus(ST_IDOL);
    }

};

// 入力：プログラムデータ設定.クロック制御
static auto inputMidiData = [&](MidiPacket packet){
    // init bung
    if(packet == CLOCK && mStatus == ST_LORD_INPUT){
        // clock信号
        ++mClockCount;
        // 16step進んだ所で終了
        if(mClockCount >= 16 * CLOCK4STEP){
            // Midiglue::Debug::write_log("ip:STOP");
            setStatus(ST_IDOL);
            reDrow();
        }
    }
    else if(packet == START || packet == CONTINUE) {
        // Midiglue::Debug::write_log("ip:START");
        // ステータス設定（クリア）
        setStatus(ST_LORD_INPUT);
        mClockCount = 0;
    }
    else if(packet == STOP){
        // ステータス設定（完了）
        setStatus(ST_IDOL);
        reDrow();
    }
    else if(packet.isNote() && 0 < packet.getControlValue()){
        // ノートONの場合
        static uint8_t ch;
        static uint8_t step;
        static uint8_t x;
        static uint8_t y;

        // channelとstep取得
        ch = (packet.getChannel() - 1) % 8;     // ch(0-7に変換)
        step = mClockCount / CLOCK4STEP;        // step(0-15)

        // 座標に変換
        x = step % 8;
        y = ch * 2 + (step < 8 ? 0:1);

        // Midiglue::Debug::write_log("ip:ch",ch);
        // Midiglue::Debug::write_log("ip:step",step);
        // Midiglue::Debug::write_log("ip:x",x);
        // Midiglue::Debug::write_log("ip:y",y);

        // マトリクスへのデータ設定
        if(packet.getVelocity() > 120){         // 120
            mPrgStateMap[y][x] = PRGST_FILL2;
        }
        else if(packet.getVelocity() > 100){    // 100
            mPrgStateMap[y][x] = PRGST_FILL1;
        }
        else {
            mPrgStateMap[y][x] = PRGST_SET;
        }
    }
};


// 入力：grooveBox
static auto inputMidi = [&](MidiPacket packet){

    if(mStatus<ST_LORD_WAIT){ // 通常ステータス
        inputMidiNomal(packet);
    } else {
        inputMidiData(packet);
    }
};

// メモリ初期化
static auto initPrgStateMap = [&](){
    // メモリ内容を全て初期化する。
    crearPrgStateMap();
    setStatus(ST_IDOL);

    // // 色テスト用
    // uint8_t i = 0;
    // for(i=0;i<SCROOL_MAX;i++) {
    //     mPrgStateMap[i][1] = PRGST_SET;
    // }
    // for(i=0;i<SCROOL_MAX;i++) {
    //     mPrgStateMap[i][3] = PRGST_FILL1;
    // }
    // for(i=0;i<SCROOL_MAX;i++) {
    //     mPrgStateMap[i][5] = PRGST_FILL2;
    // }
};


/*********************************************
* 実行処理
**********************************************/

// バッファクリア
mpDispLp3->clear();

// セットアップ
if (@setup){
    // プログラムステータスマップの初期化
    initPrgStateMap();
    // 4秒後に初期表示処理を呼び出す
    initEvent->schedule(4000 * 1000);
}
else if (@in0){ // Enable
    if (in0 == 0) {
        lpEnable = false;
    } else {
        lpEnable = true;
        reDrow();
    }
}
else if (@in1){ // goove boxからの入力
    //
    inputMidi(in1);
}
else if (@in2) { // LaunchPadからの入力
    inputLaunchPad(in2);
}
else if (@in3) { // varGageBoxからの入力
    // midi outへの出力
    if(${LinkBarGage} && (in3 == 2)){
        sendProgramchange(mSettingPrgNo);
        updateExMuteEnable(mNowPrgNo,mSettingPrgNo);

        // program No の変更
        uint8_t oldPrgNo = mNowPrgNo;
        mNowPrgNo = mSettingPrgNo;
        // Launch Pad描画
        drowProglamNo(oldPrgNo);
        drowProglamNo(mNowPrgNo);
    }
}

// バッファがあればlaunchpadに送信
if(0<mpDispLp3->size()){
    outLaunchPad();
}
